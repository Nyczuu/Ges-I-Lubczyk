<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    This repo restores from nuget.org only.

    <clear /> is the load-bearing element: without a repo-level config, NuGet merges the
    machine-level %APPDATA%\NuGet\NuGet.Config, which on a developer machine may carry
    private corporate feeds from unrelated work. Restore then queries those feeds for every
    package and fails the whole solution with NU1301 / 401 when their credentials expire —
    a failure that has nothing to do with this repo and gives no hint of its real origin.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
