@model IngredientSearchModel

@{
    Layout = "_AdminPopupLayout";

    ViewBag.PageTitle = T("Plugins.Misc.Ingredients.ProductIngredients.AddNew").Text;
}

@if (ViewBag.RefreshPage == true)
{
    <script>
        try {window.opener.document.forms['@(Context.Request.Query["formId"])'].@(Context.Request.Query["btnId"]).click();}
        catch (e){}
        window.close();
    </script>
}
else
{
<form id="product-ingredient-add-popup-form" asp-controller="IngredientsAdmin" asp-action="ProductIngredientAddPopup"
      asp-route-productId="@Context.Request.Query["productId"]"
      asp-route-btnId="@Context.Request.Query["btnId"]"
      asp-route-formId="@Context.Request.Query["formId"]">
    <input type="hidden" asp-for="ProductId" />
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Misc.Ingredients.ProductIngredients.AddNew")
        </h1>
    </div>
    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default card-search card-popup">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group row">
                                        <div class="col-sm-5">
                                            <nop-label asp-for="SearchName" />
                                        </div>
                                        <div class="col-sm-7">
                                            <nop-editor asp-for="SearchName" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <button type="button" id="search-product-ingredients-popup" class="btn btn-primary btn-search">
                                        <i class="fas fa-magnifying-glass"></i>
                                        @T("Admin.Common.Search")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card card-default">
                        <div class="card-body">
                            @await Html.PartialAsync("Table", new DataTablesModel
                            {
                                Name = "product-ingredients-popup-grid",
                                UrlRead = new DataUrl("ProductIngredientAddPopupList", "IngredientsAdmin", new RouteValueDictionary { [nameof(Model.ProductId)] = Model.ProductId }),
                                SearchButtonId = "search-product-ingredients-popup",
                                Length = Model.PageSize,
                                LengthMenu = Model.AvailablePageSizes,
                                Filters = new List<FilterParameter>
                                {
                                    new FilterParameter(nameof(Model.SearchName))
                                },
                                ColumnCollection = new List<ColumnProperty>
                                {
                                    new ColumnProperty(nameof(IngredientModel.Id))
                                    {
                                        IsMasterCheckBox = true,
                                        Render = new RenderCheckBox(nameof(AddProductIngredientModel.SelectedIngredientIds)),
                                        ClassName = NopColumnClassDefaults.CenterAll,
                                        Width = "50"
                                    },
                                    new ColumnProperty(nameof(IngredientModel.Name))
                                    {
                                        Title = T("Plugins.Misc.Ingredients.Fields.Name").Text
                                    }
                                }
                            })
                        </div>
                        <div class="card-footer">
                            <button type="submit" name="save" class="btn btn-primary">
                                <i class="far fa-floppy-disk"></i>
                                @T("Admin.Common.Save")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
<script asp-location="Footer">
    $(function () {
        //the grid re-queries the server on every page/search change, which wipes and re-renders every
        //checkbox unchecked - without this, only whatever is checked on the CURRENT page at Save time
        //gets submitted, silently dropping selections made on pages the admin already navigated away from
        var $table = $('#product-ingredients-popup-grid');
        var persistedIds = new Set();

        $table.on('change', 'input.checkboxGroups', function () {
            var id = $(this).val();
            if ($(this).is(':checked')) {
                persistedIds.add(id);
            } else {
                persistedIds.delete(id);
            }
        });

        //re-apply the checked state for rows the admin already selected whenever this page/search result
        //re-renders them, so a page revisited later still shows what was picked
        $table.on('draw.dt', function () {
            $table.find('input.checkboxGroups').each(function () {
                if (persistedIds.has($(this).val())) {
                    $(this).prop('checked', true);
                }
            });
            updateMasterCheckbox($table.parents('.dt-scroll').first());
        });

        $('#product-ingredient-add-popup-form').on('submit', function () {
            //hand off submission from the checkboxes (only the current page's) to hidden inputs built
            //from the full persisted set, so nothing already checked on another page gets lost
            $table.find('input.checkboxGroups[name="SelectedIngredientIds"]').removeAttr('name');
            var $form = $(this);
            persistedIds.forEach(function (id) {
                $('<input>').attr({ type: 'hidden', name: 'SelectedIngredientIds', value: id }).appendTo($form);
            });
        });
    });
</script>
}
