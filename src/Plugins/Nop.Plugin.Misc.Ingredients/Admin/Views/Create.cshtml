@model IngredientModel

@{
    ViewBag.PageTitle = T("Plugins.Misc.Ingredients.Ingredients.AddNew").Text;
    NopHtml.SetActiveMenuItemSystemName(IngredientsDefaults.IngredientsMenuSystemName);
}

<form asp-controller="IngredientsAdmin" asp-action="Create" method="post">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Misc.Ingredients.Ingredients.AddNew")
            <small>
                <i class="fas fa-arrow-circle-left"></i>
                <a asp-action="List">@T("Plugins.Misc.Ingredients.Ingredients.BackToList")</a>
            </small>
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.Save")
            </button>
            <button type="submit" name="save-continue" class="btn btn-primary">
                <i class="far fa-floppy-disk"></i>
                @T("Admin.Common.SaveContinue")
            </button>
        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdate", Model)
</form>
