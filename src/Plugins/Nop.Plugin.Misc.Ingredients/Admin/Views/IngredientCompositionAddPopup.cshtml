@model IngredientSearchModel

@{
    Layout = "_AdminPopupLayout";

    ViewBag.PageTitle = T("Plugins.Misc.Ingredients.Composition.AddNew").Text;
}

@if (ViewBag.RefreshPage == true)
{
    <script>
        try {window.opener.document.forms['@(Context.Request.Query["formId"])'].@(Context.Request.Query["btnId"]).click();}
        catch (e){}
        window.close();
    </script>
}
else
{
<form id="ingredient-composition-add-popup-form" asp-controller="IngredientsAdmin" asp-action="IngredientCompositionAddPopup"
      asp-route-parentIngredientId="@Context.Request.Query["parentIngredientId"]"
      asp-route-btnId="@Context.Request.Query["btnId"]"
      asp-route-formId="@Context.Request.Query["formId"]">
    <input type="hidden" asp-for="ParentIngredientId" />
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Misc.Ingredients.Composition.AddNew")
        </h1>
    </div>
    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default card-search card-popup">
                        <div class="card-body">
                            <div class="row">
                                <div class="col-sm-6">
                                    <div class="form-group row">
                                        <div class="col-sm-5">
                                            <nop-label asp-for="SearchName" />
                                        </div>
                                        <div class="col-sm-7">
                                            <nop-editor asp-for="SearchName" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-sm-12">
                                    <button type="button" id="search-ingredients-popup" class="btn btn-primary btn-search">
                                        <i class="fas fa-magnifying-glass"></i>
                                        @T("Admin.Common.Search")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card card-default">
                        <div class="card-body">
                            @await Html.PartialAsync("Table", new DataTablesModel
                            {
                                Name = "ingredients-popup-grid",
                                UrlRead = new DataUrl("IngredientCompositionAddPopupList", "IngredientsAdmin", new RouteValueDictionary { [nameof(Model.ParentIngredientId)] = Model.ParentIngredientId }),
                                SearchButtonId = "search-ingredients-popup",
                                Length = Model.PageSize,
                                LengthMenu = Model.AvailablePageSizes,
                                Filters = new List<FilterParameter>
                                {
                                    new FilterParameter(nameof(Model.SearchName))
                                },
                                ColumnCollection = new List<ColumnProperty>
                                {
                                    new ColumnProperty(nameof(IngredientModel.Id))
                                    {
                                        IsMasterCheckBox = true,
                                        Render = new RenderCheckBox(nameof(AddIngredientCompositionModel.SelectedIngredientIds)),
                                        ClassName = NopColumnClassDefaults.CenterAll,
                                        Width = "50"
                                    },
                                    new ColumnProperty(nameof(IngredientModel.Name))
                                    {
                                        Title = T("Plugins.Misc.Ingredients.Fields.Name").Text
                                    }
                                }
                            })
                        </div>
                        <div class="card-footer">
                            <button type="submit" name="save" class="btn btn-primary">
                                <i class="far fa-floppy-disk"></i>
                                @T("Admin.Common.Save")
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
<script asp-location="Footer" src="~/Plugins/Misc.Ingredients/Content/js/persisted-checkbox-selection.js"></script>
<script asp-location="Footer">
    $(function () {
        initPersistedCheckboxSelection({
            gridSelector: '#ingredients-popup-grid',
            formSelector: '#ingredient-composition-add-popup-form',
            hiddenFieldName: 'SelectedIngredientIds'
        });
    });
</script>
}
