@model ServingSuggestionStepModel

@{
    Layout = "_AdminPopupLayout";

    ViewBag.PageTitle = T("Plugins.Misc.ServingSuggestions.Steps.EditStepDetails").Text;
}
<form asp-controller="ServingSuggestion" asp-action="ServingSuggestionStepEditPopup"
      asp-route-btnId="@Context.Request.Query["btnId"]"
      asp-route-formId="@Context.Request.Query["formId"]">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Misc.ServingSuggestions.Steps.EditStepDetails")
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                @T("Admin.Common.Save")
            </button>
        </div>
    </div>
    @await Html.PartialAsync("_CreateOrUpdateStep", Model)
</form>
