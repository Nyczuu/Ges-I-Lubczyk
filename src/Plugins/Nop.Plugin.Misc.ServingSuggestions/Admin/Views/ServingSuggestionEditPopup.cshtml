@model ServingSuggestionModel

@{
    Layout = "_AdminPopupLayout";

    ViewBag.PageTitle = Model.HasServingSuggestion
        ? T("Plugins.Misc.ServingSuggestions.ServingSuggestion.Edit").Text
        : T("Plugins.Misc.ServingSuggestions.ServingSuggestion.AddNew").Text;
}

@if (ViewBag.RefreshPage == true)
{
    <script>
        try {window.opener.document.forms['@(Context.Request.Query["formId"])'].@(Context.Request.Query["btnId"]).click();}
        catch (e){}
        window.close();
    </script>
}
else
{
    <form asp-controller="ServingSuggestion" asp-action="ServingSuggestionEditPopup" enctype="multipart/form-data"
          asp-route-btnId="@Context.Request.Query["btnId"]"
          asp-route-formId="@Context.Request.Query["formId"]">
        <input asp-for="Id" type="hidden" />
        <input asp-for="ProductId" type="hidden" />
        <input asp-for="PictureId" type="hidden" />
        <div class="content-header clearfix">
            <h1 class="float-left">
                @ViewBag.PageTitle
            </h1>
            <div class="float-right">
                <button type="submit" name="save" class="btn btn-primary">
                    <i class="far fa-floppy-disk"></i>
                    @T("Admin.Common.Save")
                </button>
            </div>
        </div>
        <section class="content">
            <div class="container-fluid">
                <div class="form-horizontal">
                    <div class="cards-group">
                        <div class="card card-default card-popup">
                            <div class="card-body">
                                <div asp-validation-summary="All"></div>
                                @(await Html.LocalizedEditorAsync<ServingSuggestionModel, ServingSuggestionLocalizedModel>("servingsuggestion-localized",
                                @<div>
                                    <div class="form-group row">
                                        <div class="col-sm-3">
                                            <nop-label asp-for="@Model.Locales[item].Title" />
                                        </div>
                                        <div class="col-sm-9">
                                            <nop-editor asp-for="@Model.Locales[item].Title" />
                                            <span asp-validation-for="@Model.Locales[item].Title"></span>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-sm-3">
                                            <nop-label asp-for="@Model.Locales[item].Description" />
                                        </div>
                                        <div class="col-sm-9">
                                            <nop-editor asp-for="@Model.Locales[item].Description" />
                                            <span asp-validation-for="@Model.Locales[item].Description"></span>
                                        </div>
                                    </div>
                                    <input type="hidden" asp-for="@Model.Locales[item].LanguageId" />
                                </div>
                                ,
                                @<div>
                                    <div class="form-group row">
                                        <div class="col-sm-3">
                                            <nop-label asp-for="Title" />
                                        </div>
                                        <div class="col-sm-9">
                                            <nop-editor asp-for="Title" asp-required="true" />
                                            <span asp-validation-for="Title"></span>
                                        </div>
                                    </div>
                                    <div class="form-group row">
                                        <div class="col-sm-3">
                                            <nop-label asp-for="Description" />
                                        </div>
                                        <div class="col-sm-9">
                                            <nop-editor asp-for="Description" />
                                            <span asp-validation-for="Description"></span>
                                        </div>
                                    </div>
                                </div>
                                ))
                                <div class="form-group row">
                                    <div class="col-sm-3">
                                        @T("Plugins.Misc.ServingSuggestions.Fields.Picture")
                                    </div>
                                    <div class="col-sm-9">
                                        @if (Model.HasServingSuggestion)
                                        {
                                            <img src="@Model.PictureUrl" class="img-thumbnail mb-2" style="max-width:200px" alt="@Model.Title" />
                                        }
                                        <input type="file" name="picturefile" accept="image/*" />
                                        <span asp-validation-for="PictureId"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </form>
}
