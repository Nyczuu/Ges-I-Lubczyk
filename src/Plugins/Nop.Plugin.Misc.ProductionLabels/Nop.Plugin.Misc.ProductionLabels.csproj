<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Copyright>Copyright © Ges I Lubczyk</Copyright>
    <Company>Ges I Lubczyk</Company>
    <Authors>Ges I Lubczyk</Authors>
    <PackageLicenseUrl></PackageLicenseUrl>
    <OutputPath>$(SolutionDir)\Presentation\Nop.Web\Plugins\Misc.ProductionLabels</OutputPath>
    <OutDir>$(OutputPath)</OutDir>
    <!--Set this parameter to true to get the dlls copied from the NuGet cache to the output of your project.
    You need to set this parameter to true if your plugin has a nuget package
    to ensure that the dlls copied from the NuGet cache to the output of your project-->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!--Npgsql.PostgresException is used directly (not just transitively through Nop.Data) to detect that
    Nop.Plugin.Misc.Ingredients' own tables are missing (SQLSTATE 42P01, undefined_table) when that plugin
    has been uninstalled - see ProductionLabelModelFactory's graceful-degrade catch. Version pinned to
    match Nop.Data.csproj, same as Nop.Plugin.Misc.Ingredients.csproj.-->
    <PackageReference Include="Npgsql" Version="10.0.2" />
    <!--Drives the concrete IHtmlToPdfConverter (spec Section 13's build-and-render smoke test resolved
    this as the chosen library). Launches system Chromium (installed via apk in the runtime image, never
    downloaded at runtime) headless and renders the label template through it - see
    PuppeteerSharpHtmlToPdfConverter.-->
    <PackageReference Include="PuppeteerSharp" Version="25.8.0" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="logo.png" />
    <None Remove="plugin.json" />
    <None Remove="Admin\Views\Components\ProductionLabels.cshtml" />
    <None Remove="Admin\Views\GenerateLabelPopup.cshtml" />
    <None Remove="Admin\Views\List.cshtml" />
    <None Remove="Admin\Views\ProductionBatchCreatePopup.cshtml" />
    <None Remove="Admin\Views\ProductionLabelTemplate.cshtml" />
    <None Remove="Admin\Views\_ViewImports.cshtml" />
    <None Remove="Admin\Views\_ViewStart.cshtml" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="logo.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="plugin.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Admin\Views\Components\ProductionLabels.cshtml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Admin\Views\GenerateLabelPopup.cshtml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Admin\Views\List.cshtml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Admin\Views\ProductionBatchCreatePopup.cshtml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Admin\Views\ProductionLabelTemplate.cshtml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Admin\Views\_ViewImports.cshtml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="Admin\Views\_ViewStart.cshtml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)\Presentation\Nop.Web\Nop.Web.csproj" />
    <ProjectReference Include="$(SolutionDir)\Plugins\Nop.Plugin.Misc.Ingredients\Nop.Plugin.Misc.Ingredients.csproj" />
    <ClearPluginAssemblies Include="$(SolutionDir)\Build\ClearPluginAssemblies.proj" />
  </ItemGroup>

  <!-- This target execute after "Build" target -->
  <Target Name="NopTarget" AfterTargets="Build">
    <!-- Delete unnecessary libraries from plugins path -->
    <MSBuild Projects="@(ClearPluginAssemblies)" Properties="PluginPath=$(OutDir)" Targets="NopClear" />
  </Target>

</Project>
