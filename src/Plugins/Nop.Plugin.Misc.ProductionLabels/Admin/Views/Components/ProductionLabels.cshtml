@model ProductionLabelsProductModel

@{
    const string hideProductionLabelsBlockAttributeName = "ProductPage.HideProductionLabelsBlock";
    var customer = await workContext.GetCurrentCustomerAsync();
    var hideProductionLabelsBlock = await genericAttributeService.GetAttributeAsync<bool>(customer, hideProductionLabelsBlockAttributeName);
}

<nop-card asp-name="production-labels" asp-icon="fas fa-tags" asp-title="@T("Plugins.Misc.ProductionLabels.Production")" asp-hide-block-attribute-name="@hideProductionLabelsBlockAttributeName" asp-hide="@hideProductionLabelsBlock">
    <div class="card-body">
        @if (Model.ProductId > 0)
        {
            <div class="card card-default">
                <div class="card-body">
                    @await Html.PartialAsync("Table", new DataTablesModel
                    {
                        Name = "production-labels-batches-grid",
                        UrlRead = new DataUrl("List", "ProductionLabelsAdmin", new RouteValueDictionary { [nameof(Model.BatchSearchModel.SearchProductId)] = Model.ProductId }),
                        UrlDelete = new DataUrl("ProductionBatchDelete", "ProductionLabelsAdmin", null),
                        Length = Model.BatchSearchModel.PageSize,
                        LengthMenu = Model.BatchSearchModel.AvailablePageSizes,
                        ColumnCollection = new List<ColumnProperty>
                        {
                            new ColumnProperty(nameof(ProductionBatchModel.BatchCode))
                            {
                                Title = T("Plugins.Misc.ProductionLabels.Fields.BatchCode").Text
                            },
                            new ColumnProperty(nameof(ProductionBatchModel.BestBeforeDateUtc))
                            {
                                Title = T("Plugins.Misc.ProductionLabels.Fields.BestBeforeDate").Text,
                                Render = new RenderDate()
                            },
                            new ColumnProperty(nameof(ProductionBatchModel.Quantity))
                            {
                                Title = T("Plugins.Misc.ProductionLabels.Fields.Quantity").Text,
                                ClassName = NopColumnClassDefaults.CenterAll
                            },
                            new ColumnProperty(nameof(ProductionBatchModel.Id))
                            {
                                Title = T("Plugins.Misc.ProductionLabels.GenerateLabel").Text,
                                Width = "150",
                                ClassName = NopColumnClassDefaults.Button,
                                Render = new RenderCustom("renderColumnGenerateLabel")
                            },
                            new ColumnProperty(nameof(ProductionBatchModel.Id))
                            {
                                Title = T("Admin.Common.Delete").Text,
                                Width = "100",
                                Render = new RenderButtonRemove(T("Admin.Common.Delete").Text),
                                ClassName = NopColumnClassDefaults.Button
                            }
                        }
                    })
                </div>
                <div class="card-footer">
                    <button type="submit" id="btnAddNewProductionBatch" class="btn btn-primary" onclick="javascript:OpenWindow('@(Url.Action("ProductionBatchCreatePopup", "ProductionLabelsAdmin", new {productId = Model.ProductId, btnId = "btnRefreshProductionBatches", formId = "product-form"}))', 800, 800, true); return false;">
                        @T("Plugins.Misc.ProductionLabels.ProductionBatches.AddNew")
                    </button>
                    <button type="submit" id="btnRefreshProductionBatches" style="display: none"></button>
                    <script>
                        function renderColumnGenerateLabel(data, type, row, meta) {
                            return '<button type="button" onclick="javascript:OpenWindow(\'@Url.Action("GenerateLabelPopup", "ProductionLabelsAdmin")' + '?productionBatchId=' + row.Id + '\', 800, 800, true); return false;" class="btn btn-default">@T("Plugins.Misc.ProductionLabels.GenerateLabel").Text</button>';
                        }
                        $(function() {
                            $('#btnRefreshProductionBatches').click(function () {
                                updateTable('#production-labels-batches-grid');
                                return false;
                            });
                        });
                    </script>
                </div>
            </div>

            <div class="card card-default mt-3">
                <div class="card-body">
                    <form asp-controller="ProductionLabelsAdmin" asp-action="SaveProductInfo">
                        <input asp-for="ProductId" type="hidden" />
                        @(await Html.LocalizedEditorAsync<ProductionLabelsProductModel, ProductionLabelsProductLocalizedModel>("productionlabels-productinfo-localized",
                        @<div>
                            <div class="form-group row">
                                <div class="col-sm-3">
                                    <nop-label asp-for="@Model.Locales[item].StorageConditions" />
                                </div>
                                <div class="col-sm-9">
                                    <nop-editor asp-for="@Model.Locales[item].StorageConditions" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-sm-3">
                                    <nop-label asp-for="@Model.Locales[item].CountryOfOrigin" />
                                </div>
                                <div class="col-sm-9">
                                    <nop-editor asp-for="@Model.Locales[item].CountryOfOrigin" />
                                </div>
                            </div>
                            <input type="hidden" asp-for="@Model.Locales[item].LanguageId" />
                        </div>
                        ,
                        @<div>
                            <div class="form-group row">
                                <div class="col-sm-3">
                                    <nop-label asp-for="StorageConditions" />
                                </div>
                                <div class="col-sm-9">
                                    <nop-editor asp-for="StorageConditions" />
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-sm-3">
                                    <nop-label asp-for="CountryOfOrigin" />
                                </div>
                                <div class="col-sm-9">
                                    <nop-editor asp-for="CountryOfOrigin" />
                                </div>
                            </div>
                        </div>
                        ))
                        <div class="form-group row">
                            <div class="col-sm-9 offset-sm-3">
                                <button type="submit" class="btn btn-primary">
                                    @T("Admin.Common.Save")
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="card card-default">
                <div class="card-body">
                    @T("Plugins.Misc.ProductionLabels.ProductionBatches.SaveBeforeEdit")
                </div>
            </div>
        }
    </div>
</nop-card>
