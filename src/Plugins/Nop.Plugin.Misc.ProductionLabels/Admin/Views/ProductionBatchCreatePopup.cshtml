@model ProductionBatchModel

@{
    Layout = "_AdminPopupLayout";

    ViewBag.PageTitle = T("Plugins.Misc.ProductionLabels.ProductionBatches.AddNew").Text;
}
<form asp-controller="ProductionLabelsAdmin" asp-action="ProductionBatchCreatePopup"
      asp-route-btnId="@Context.Request.Query["btnId"]"
      asp-route-formId="@Context.Request.Query["formId"]">
    <div class="content-header clearfix">
        <h1 class="float-left">
            @T("Plugins.Misc.ProductionLabels.ProductionBatches.AddNew")
        </h1>
        <div class="float-right">
            <button type="submit" name="save" class="btn btn-primary">
                @T("Admin.Common.Save")
            </button>
        </div>
    </div>

    <div asp-validation-summary="All"></div>

    @if (ViewBag.RefreshPage == true)
    {
        <script>
            try {window.opener.document.forms['@(Context.Request.Query["formId"])'].@(Context.Request.Query["btnId"]).click();}
            catch (e){}
            window.close();
        </script>
    }

    <section class="content">
        <div class="container-fluid">
            <div class="form-horizontal">
                <div class="cards-group">
                    <div class="card card-default card-popup">
                        <div class="card-body">
                            @if (Model.AvailableProducts.Any())
                            {
                                <div class="form-group row">
                                    <div class="col-sm-3">
                                        <nop-label asp-for="ProductId" />
                                    </div>
                                    <div class="col-sm-9">
                                        <nop-select asp-for="ProductId" asp-items="Model.AvailableProducts" />
                                        <span asp-validation-for="ProductId"></span>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <input asp-for="ProductId" type="hidden" />
                            }
                            <input asp-for="DefaultShelfLifeDays" type="hidden" />
                            <div class="form-group row">
                                <div class="col-sm-3">
                                    <nop-label asp-for="ProductionDateUtc" />
                                </div>
                                <div class="col-sm-9">
                                    <nop-editor asp-for="ProductionDateUtc" />
                                    <span asp-validation-for="ProductionDateUtc"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-sm-3">
                                    <nop-label asp-for="BestBeforeDateUtc" />
                                </div>
                                <div class="col-sm-9">
                                    <nop-editor asp-for="BestBeforeDateUtc" />
                                    <span asp-validation-for="BestBeforeDateUtc"></span>
                                </div>
                            </div>
                            <div class="form-group row">
                                <div class="col-sm-3">
                                    <nop-label asp-for="Quantity" />
                                </div>
                                <div class="col-sm-9">
                                    <nop-editor asp-for="Quantity" asp-required="true" />
                                    <span asp-validation-for="Quantity"></span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</form>
<script>
    $(function () {
        //don't clobber a manual edit (spec §6): once the admin has genuinely typed into Best-before
        //themselves, further Production-date changes stop overwriting it. Programmatic .val(...) writes
        //below never trigger a native 'change' event, so this flag only flips on a real user edit.
        var bestBeforeManuallyEdited = false;

        //UTC-based arithmetic (Date.parse treats a plain 'yyyy-MM-dd' string as UTC midnight) so the
        //result is unaffected by the browser's local timezone/DST offset
        function addDaysToIsoDate(isoDateString, days) {
            var msPerDay = 24 * 60 * 60 * 1000;
            var startTime = Date.parse(isoDateString);
            if (isNaN(startTime))
                return null;

            var result = new Date(startTime + days * msPerDay);

            var year = result.getUTCFullYear();
            var month = ('0' + (result.getUTCMonth() + 1)).slice(-2);
            var dayOfMonth = ('0' + result.getUTCDate()).slice(-2);

            return year + '-' + month + '-' + dayOfMonth;
        }

        function prefillBestBeforeDate() {
            var defaultShelfLifeDays = parseInt($('#DefaultShelfLifeDays').val(), 10);
            if (isNaN(defaultShelfLifeDays) || bestBeforeManuallyEdited)
                return;

            var newBestBeforeDate = addDaysToIsoDate($('#ProductionDateUtc').val(), defaultShelfLifeDays);
            if (newBestBeforeDate === null)
                return;

            $('#BestBeforeDateUtc').val(newBestBeforeDate);
        }

        $('#BestBeforeDateUtc').on('change', function () {
            bestBeforeManuallyEdited = true;
        });

        $('#ProductionDateUtc').on('change', function () {
            prefillBestBeforeDate();
        });

        @if (Model.AvailableProducts.Any())
        {
            <text>
        //standalone flow only: the product isn't known until the admin picks one from the dropdown, so
        //its configured default shelf-life is read on demand
        $('#ProductId').on('change', function () {
            $.ajax({
                cache: false,
                type: 'GET',
                url: '@Url.Action("GetDefaultShelfLifeDays", "ProductionLabelsAdmin")',
                data: { productId: $(this).val() },
                success: function (data) {
                    $('#DefaultShelfLifeDays').val(data.DefaultShelfLifeDays);
                    //a new product selection is a fresh context - re-arm the prefill (Gate 1 resolution)
                    bestBeforeManuallyEdited = false;
                    prefillBestBeforeDate();
                }
            });
        });
            </text>
        }
    });
</script>
